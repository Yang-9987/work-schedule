{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/work-schedule",
      "destination": "/work-schedule/",
      "permanent": true
    },
    {
      "source": "/school-calendar",
      "destination": "/school-calendar/",
      "permanent": true
    },
    {
      "source": "/duty-roster",
      "destination": "/duty-roster/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/work-schedule/",
      "destination": "/modules/work-schedule/index.html"
    },
    {
      "source": "/work-schedule/config.json",
      "destination": "/config.json"
    },
    {
      "source": "/school-calendar/",
      "destination": "/modules/school-calendar/index.html"
    },
    {
      "source": "/duty-roster/",
      "destination": "/modules/duty-roster/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
